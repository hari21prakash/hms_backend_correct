{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "HospitalManagement.Api",
    "Audience": "HospitalManagement.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "AmbulanceAutomation": {
    "Enabled": true,
    "PickupRadiusMeters": 100,
    "HospitalRadiusMeters": 150,
    "MaxAccuracyMeters": 50,
    "DwellSeconds": 15,
    "MaxPlausibleSpeedKmh": 200,
    "HospitalName": "",
    "HospitalLatitude": null,
    "HospitalLongitude": null
  },
  "Notifications": {
    "SchedulerEnabled": true,
    "ScanIntervalMinutes": 15
  },
  "SeedDemoData": false,
  "BootstrapAdmin": {
    "Email": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
